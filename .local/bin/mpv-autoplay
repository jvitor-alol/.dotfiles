#!/usr/bin/env bash
# ~/.local/bin/mpv-autoplay

set -euo pipefail

MV_DIR="$(xdg-user-dir VIDEOS)/[03] MVs"
BLACKLIST="$HOME/.config/mpv/blacklist.txt"
LOG_FILE="/tmp/mpv-autoplay.log"

command -v fd >/dev/null || {
    echo "Erro: fd not found."
    exit 1
}

command -v mpv >/dev/null || {
    echo "Erro: mpv not found."
    exit 1
}

playlist() {
    fd . "$MV_DIR" \
        --absolute-path \
        -e mp4 \
        -e mkv \
        -e webm \
        -e ts \
        -e mov \
        -e m4v
}

filtered_playlist() {
    if [[ -f "$BLACKLIST" ]]; then
        playlist \
            | grep -F -v -f <(
                grep -Ev '^\s*(#|$)' "$BLACKLIST"
            )
    else
        playlist
    fi
}

exec env MANGOHUD=0 mpv \
    --input-ipc-server=/tmp/mpv-socket \
    --log-file="$LOG_FILE" \
    --msg-level=all=v \
    --playlist=- \
    < <(
        filtered_playlist | shuf
    )
