#!/usr/bin/env bash
# ~/.local/bin/kvm-display-switch

HDMI_STATUS="/sys/class/drm/card1-HDMI-A-1/status"

refresh_session_env() {
    local env name value

    env="$(systemctl --user show-environment)" || return 1

    while IFS='=' read -r name value; do
        case "$name" in
            WAYLAND_DISPLAY|DISPLAY|XAUTHORITY|XDG_RUNTIME_DIR|DBUS_SESSION_BUS_ADDRESS|XDG_CURRENT_DESKTOP)
                printf -v "$name" '%s' "$value"
                export "$name"
                ;;
        esac
    done <<< "$env"

    [[ -n "${WAYLAND_DISPLAY:-}" && -n "${XDG_RUNTIME_DIR:-}" ]]
}

if [[ ! -r "$HDMI_STATUS" ]]; then
    echo "Erro: não foi possível ler $HDMI_STATUS"
    exit 1
fi

previous="$(cat "$HDMI_STATUS")"
echo "Initial status: $previous"

udevadm monitor --udev --subsystem-match=drm |
while IFS= read -r event; do
    [[ "$event" == *" change "* ]] || continue
    [[ -r "$HDMI_STATUS" ]] || continue

    sleep 0.5
    current="$(cat "$HDMI_STATUS")"

    # Ignore DRM events that didn't change the HDMI status.
    [[ "$current" == "$previous" ]] && continue

    echo "HDMI: $previous -> $current"

    if [[ "$previous" == "connected" && "$current" == "disconnected" ]]; then
        echo "KVM switched from PC: DPMS off"

        if refresh_session_env; then
            echo "WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
            echo "DISPLAY=${DISPLAY:-UNSET}"

            kscreenctl off
            status=$?
            echo "kscreenctl exit status: $status"
        else
            echo "Erro: ambiente gráfico indisponível; DPMS não executado."
        fi
    fi

    previous="$current"
done
